# --- App ---
# Set OPENAI_API_KEY to use OpenAI. If empty, the app automatically uses the
# local Ollama server (LLM_OLLAMA_MODEL below) instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# --- Local LLM (Ollama) fallback ---
LLM_OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_OLLAMA_MODEL=llama3.2:3b

# --- Auth ---
JWT_SECRET=generate-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Knowledge base ---
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
KB_TOP_K=4

# --- Runtime ---
DATABASE_URL=sqlite+aiosqlite:///./data/chatbot.db
DEBUG=false
SERVE_FRONTEND=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=30
